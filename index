<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Range Card — Mil Hold Calculator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#12140F;
    --panel:#1B1E15;
    --panel-2:#20241A;
    --line:#3A3F2C;
    --line-soft:#282B1F;
    --amber:#E3A857;
    --amber-dim:#8A6B3C;
    --olive:#7C8A5C;
    --bone:#EDE8D8;
    --bone-dim:#9AA089;
    --warn:#C2564A;
    --ok:#8FAE6C;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(1200px 600px at 50% -10%, #1a1d13 0%, var(--bg) 60%);
    color:var(--bone);
    font-family:'JetBrains Mono', monospace;
    min-height:100vh;
    padding:28px 16px 60px;
  }
  .wrap{max-width:720px;margin:0 auto;}

  header{
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    border-bottom:1px solid var(--line);
    padding-bottom:14px;
    margin-bottom:22px;
    flex-wrap:wrap;
    gap:6px;
  }
  header h1{
    font-family:'Oswald', sans-serif;
    font-weight:700;
    font-size:1.5rem;
    letter-spacing:0.04em;
    margin:0;
    color:var(--bone);
  }
  header h1 span{color:var(--amber);}
  header .sub{
    font-size:0.72rem;
    color:var(--bone-dim);
    letter-spacing:0.02em;
  }

  .panel{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:3px;
    padding:18px;
    margin-bottom:16px;
  }
  .panel-title{
    font-family:'Oswald', sans-serif;
    font-size:0.78rem;
    font-weight:600;
    letter-spacing:0.08em;
    color:var(--olive);
    margin:0 0 14px 0;
    text-transform:uppercase;
  }

  .field-row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
    margin-bottom:14px;
  }
  .field{display:flex;flex-direction:column;gap:6px;}
  .field label{
    font-size:0.7rem;
    color:var(--bone-dim);
    letter-spacing:0.03em;
  }
  select, input[type=number]{
    background:var(--bg);
    border:1px solid var(--line);
    color:var(--bone);
    font-family:'JetBrains Mono', monospace;
    font-size:0.92rem;
    padding:9px 10px;
    border-radius:2px;
    width:100%;
  }
  select:focus, input:focus{
    outline:none;
    border-color:var(--amber-dim);
  }
  input[type=range]{
    width:100%;
    accent-color:var(--amber);
    background:transparent;
  }
  .slider-row{display:flex;align-items:center;gap:10px;}
  .slider-row input[type=range]{flex:1;}
  .slider-val{
    min-width:58px;
    text-align:right;
    color:var(--amber);
    font-size:0.92rem;
  }

  /* Hero */
  .hero{
    background:var(--panel-2);
    border:1px solid var(--line);
    border-radius:3px;
    padding:30px 20px;
    text-align:center;
    position:relative;
    margin-bottom:16px;
    transition:border-color 0.4s ease;
  }
  .hero.pulse{border-color:var(--amber);}
  .corner{
    position:absolute;
    width:14px;height:14px;
    border-color:var(--amber-dim);
    border-style:solid;
    opacity:0.8;
  }
  .corner.tl{top:8px;left:8px;border-width:1px 0 0 1px;}
  .corner.tr{top:8px;right:8px;border-width:1px 1px 0 0;}
  .corner.bl{bottom:8px;left:8px;border-width:0 0 1px 1px;}
  .corner.br{bottom:8px;right:8px;border-width:0 1px 1px 0;}

  .hero .hold-dir{
    font-family:'Oswald', sans-serif;
    font-size:0.75rem;
    letter-spacing:0.12em;
    color:var(--bone-dim);
    text-transform:uppercase;
    margin-bottom:6px;
  }
  .hero .hold-value{
    font-size:3.6rem;
    font-weight:700;
    color:var(--amber);
    line-height:1;
    letter-spacing:0.01em;
  }
  .hero .hold-unit{
    font-size:1.1rem;
    color:var(--amber-dim);
    margin-left:6px;
  }
  .hero .hold-sub{
    margin-top:10px;
    font-size:0.78rem;
    color:var(--bone-dim);
  }

  .stats-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:12px;
  }
  .stats-grid .stat:nth-child(4),
  .stats-grid .stat:nth-child(5){
    grid-column:span 1;
  }
  .stat{
    background:var(--bg);
    border:1px solid var(--line-soft);
    border-radius:2px;
    padding:10px 12px;
  }
  .stat .k{font-size:0.65rem;color:var(--bone-dim);letter-spacing:0.03em;margin-bottom:5px;}
  .stat .v{font-size:1.02rem;color:var(--bone);font-weight:600;}
  .stat .v.warn{color:var(--warn);}
  .stat .v.ok{color:var(--ok);}

  table{
    width:100%;
    border-collapse:collapse;
    font-size:0.82rem;
  }
  th{
    text-align:right;
    font-family:'Oswald', sans-serif;
    font-weight:500;
    font-size:0.68rem;
    letter-spacing:0.05em;
    color:var(--bone-dim);
    padding:6px 8px;
    border-bottom:1px solid var(--line);
    text-transform:uppercase;
  }
  th:first-child, td:first-child{text-align:left;}
  td{
    text-align:right;
    padding:6px 8px;
    border-bottom:1px solid var(--line-soft);
    color:var(--bone);
  }
  tr.current td{
    background:rgba(227,168,87,0.10);
    color:var(--amber);
    font-weight:600;
  }
  tr.transonic td{color:var(--warn);}

  .note{
    font-size:0.72rem;
    color:var(--bone-dim);
    line-height:1.55;
    border-top:1px solid var(--line);
    padding-top:14px;
    margin-top:6px;
  }
  .note b{color:var(--olive);}

  @media (max-width:480px){
    .hero .hold-value{font-size:2.7rem;}
    .stats-grid{grid-template-columns:repeat(2,1fr);}
    .field-row{grid-template-columns:1fr;}
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <h1>RANGE <span>CARD</span></h1>
    <div class="sub">Arma 3 mil hold-over · point-mass ballistics</div>
  </header>

  <div class="panel">
    <p class="panel-title">Load</p>
    <div class="field-row">
      <div class="field" style="grid-column:1 / -1;">
        <label for="caliber">Ammunition</label>
        <select id="caliber"></select>
      </div>
    </div>
    <div class="field-row">
      <div class="field" style="grid-column:1 / -1;">
        <label for="targetRange">Target range (m) — zeroed at 100 m</label>
        <input type="number" id="targetRange" value="500" min="25" max="2500" step="25">
      </div>
    </div>
    <div class="field">
      <label for="temp">Air temperature</label>
      <div class="slider-row">
        <input type="range" id="temp" min="-30" max="55" value="15" step="1">
        <span class="slider-val" id="tempVal">15°C</span>
      </div>
    </div>
  </div>

  <div class="panel">
    <p class="panel-title">Rifle setup</p>
    <div class="field">
      <label for="heightOverBore">Height over bore (in)</label>
      <input type="number" id="heightOverBore" value="1.97" min="0" max="6" step="0.05">
    </div>
  </div>

  <div class="hero" id="hero">
    <div class="corner tl"></div><div class="corner tr"></div>
    <div class="corner bl"></div><div class="corner br"></div>
    <div class="hold-dir" id="holdDir">Hold Over</div>
    <div><span class="hold-value" id="holdValue">0.0</span><span class="hold-unit">mil</span></div>
    <div class="hold-sub" id="holdSub">at 500 m, zeroed 300 m, 15°C</div>
  </div>

  <div class="panel">
    <p class="panel-title">At target range</p>
    <div class="stats-grid">
      <div class="stat"><div class="k">Velocity</div><div class="v" id="statVel">–</div></div>
      <div class="stat"><div class="k">Time of flight</div><div class="v" id="statTof">–</div></div>
      <div class="stat"><div class="k">Regime</div><div class="v" id="statMach">–</div></div>
    </div>
  </div>

  <div class="panel">
    <p class="panel-title">Full range card</p>
    <table id="rangeTable">
      <thead>
        <tr><th>Range</th><th>Hold</th><th>Vel</th><th>ToF</th></tr>
      </thead>
      <tbody id="rangeTableBody"></tbody>
    </table>
  </div>

  <div class="note">
    <b>Model:</b> point-mass trajectory, RK2 integration, standard G1/G7 drag curves scaled by each round's ballistic coefficient
    and true bore diameter/mass. Air density and speed of sound follow the input temperature at fixed sea-level pressure
    (1013.25 hPa, dry air). Muzzle velocity shifts with temperature using a generic powder-temperature-sensitivity
    curve (sourced from ACE3's Advanced Ballistics reference data), since vanilla Arma 3 ammo doesn't model temperature
    at all and none of your added loads came with their own measured curve. It's the same shape for every round in this
    list, so treat the *directional* effect of temperature as trustworthy but the exact number as an approximation.
    The bore starts below the sight line by the entered height-over-bore and elevation is solved so the trajectory
    crosses that line at the 100 m zero, which also reproduces the short "false zero" close to the muzzle.
    Wind, spin drift, and Coriolis are not modeled.
  </div>

</div>

<script>
// ---------- Standard drag tables (Mach, Cd) — McCoy G1 / G7 ----------
const G1 = [[0,0.2629],[0.05,0.2558],[0.1,0.2487],[0.15,0.2413],[0.2,0.2344],[0.25,0.2278],[0.3,0.2214],
  [0.35,0.2155],[0.4,0.2104],[0.45,0.2061],[0.5,0.2032],[0.55,0.202],[0.6,0.2034],[0.7,0.2165],[0.725,0.223],
  [0.75,0.2313],[0.775,0.2417],[0.8,0.2546],[0.825,0.2706],[0.85,0.2901],[0.875,0.3136],[0.9,0.3415],
  [0.925,0.3734],[0.95,0.4084],[0.975,0.4448],[1.0,0.4805],[1.025,0.5136],[1.05,0.5427],[1.075,0.5677],
  [1.1,0.5883],[1.125,0.6053],[1.15,0.6191],[1.2,0.6393],[1.25,0.6518],[1.3,0.6589],[1.35,0.6621],
  [1.4,0.6625],[1.45,0.6607],[1.5,0.6573],[1.55,0.6528],[1.6,0.6474],[1.65,0.6413],[1.7,0.6347],
  [1.75,0.628],[1.8,0.621],[1.85,0.6141],[1.9,0.6072],[1.95,0.6003],[2.0,0.5934],[2.05,0.5867],
  [2.1,0.5804],[2.15,0.5743],[2.2,0.5685],[2.25,0.563],[2.3,0.5577],[2.35,0.5527],[2.4,0.5481],
  [2.45,0.5438],[2.5,0.5397],[2.6,0.5325],[2.7,0.5264],[2.8,0.5211],[2.9,0.5168],[3.0,0.5133],
  [3.2,0.5084],[3.4,0.5054],[3.6,0.503],[3.8,0.5016],[4.0,0.5006],[4.5,0.4993],[5.0,0.4988]];

const G7 = [[0,0.1198],[0.05,0.1197],[0.1,0.1196],[0.15,0.1194],[0.2,0.1193],[0.25,0.1194],[0.3,0.1194],
  [0.35,0.1194],[0.4,0.1193],[0.45,0.1193],[0.5,0.1194],[0.55,0.1193],[0.6,0.1194],[0.65,0.1197],
  [0.7,0.1202],[0.725,0.1207],[0.75,0.1215],[0.775,0.1226],[0.8,0.1242],[0.825,0.1266],[0.85,0.1306],
  [0.875,0.1368],[0.9,0.1464],[0.925,0.166],[0.95,0.2054],[0.975,0.2993],[1.0,0.3803],[1.025,0.4015],
  [1.05,0.4043],[1.075,0.4034],[1.1,0.4014],[1.125,0.3987],[1.15,0.3955],[1.2,0.3884],[1.25,0.381],
  [1.3,0.3732],[1.35,0.3657],[1.4,0.358],[1.45,0.351],[1.5,0.344],[1.55,0.3376],[1.6,0.3315],
  [1.65,0.326],[1.7,0.3209],[1.75,0.316],[1.8,0.3117],[1.85,0.3078],[1.9,0.3042],[1.95,0.301],
  [2.0,0.298],[2.1,0.2922],[2.2,0.2864],[2.3,0.2807],[2.4,0.2752],[2.5,0.2697],[2.6,0.264],
  [2.8,0.2547],[3.0,0.2468],[3.2,0.24],[3.4,0.2341],[3.6,0.2289],[3.8,0.2245],[4.0,0.2205],
  [4.5,0.2115],[5.0,0.207]];

// ---------- Ammo library (data drawn from Arma 3's own configs and the ACE3
// Advanced Ballistics reference set, which is what most milsim groups fly with) ----------
const AMMO = {
  "65creed": { label:"6.5 Creedmoor 147gr ELD-M (Barret MRAD, 24\") — calibrated", caliber:6.71, mass:9.5, bc:0.697, drag:1,
    mvTable:[[-15,799],[-5,799],[5,801],[10,801],[15,803],[20,804],[25,805],[30,807],[35,809]], hob:2.6, maxRange:2000 },
  "65creed140_24": { label:"6.5 Creedmoor 140gr ELD-M (Barret MRAD, 24\") — calibrated", caliber:6.71, mass:9.1, bc:0.646, drag:1,
    mvTable:[[-15,807],[-5,807],[5,809],[10,809],[15,811],[20,812],[25,813],[30,815],[35,817]], hob:2.6, maxRange:2000 },
  "65creed17": { label:"6.5 Creedmoor 147gr ELD-M (Barret MRAD, 17.5\") — calibrated", caliber:6.71, mass:9.5, bc:0.697, drag:1,
    mvTable:[[-15,688.5],[-5,689.5],[5,690.5],[10,691.5],[15,692.5],[20,693.5],[25,695.5],[30,696.5],[35,698.5]], hob:2.6, maxRange:1600 },
  "65creed140_17": { label:"6.5 Creedmoor 140gr ELD-M (Barret MRAD, 17.5\") — calibrated", caliber:6.71, mass:9.1, bc:0.646, drag:1,
    mvTable:[[-15,771],[-5,772],[5,773],[10,774],[15,775],[20,776],[25,778],[30,779],[35,782]], hob:2.6, maxRange:2000 },
  "300wm212": { label:".300 Win Mag 212gr ELD-X (Barret MRAD, 26\") — calibrated", caliber:7.82, mass:13.7, bc:0.663, drag:1,
    mvTable:[[-15,866],[-5,866],[5,867],[10,868],[15,869],[20,871],[25,872],[30,874],[35,876]], hob:2.6, maxRange:2200 },
  "65creed_m110l": { label:"6.5 Creedmoor 147gr ELD-M (M110A3-L, 22\") — calibrated", caliber:6.706, mass:9.5, bc:0.697, drag:1,
    mvTable:[[-15,792],[-5,792],[5,793],[10,794],[15,795],[20,797],[25,798],[30,800],[35,802]], hob:2.8, maxRange:2000 },
  "65creed_m110s": { label:"6.5 Creedmoor 147gr ELD-M (M110A3-S, 14.5\") — calibrated", caliber:6.706, mass:9.5, bc:0.697, drag:1,
    mvTable:[[-15,665],[-5,665],[5,667],[10,667],[15,669],[20,670],[25,671],[30,673],[35,675]], hob:2.8, maxRange:1600 },
  "50bmg750amax": { label:".50 BMG 750gr A-MAX (M107A1, 29\") — calibrated", caliber:12.954, mass:48.6, bc:1.05, drag:1,
    mvTable:[[-15,855],[-5,855],[5,857],[10,857],[15,859],[20,860],[25,861],[30,863],[35,865]], hob:3.1, maxRange:2500 },
  "50bmg_mk211": { label:".50 BMG Mk211 Mod 0 Raufoss (M107A1, 29\") — calibrated", caliber:12.98, mass:42.8, bc:0.650, drag:1,
    mvTable:[[-15,845],[-5,845],[5,847],[10,847],[15,849],[20,850],[25,851],[30,853],[35,855]], hob:3.1, maxRange:2200 },
};

// ---------- Physics ----------
const Gc=9.80665, Rspec=287.058, GAMMA=1.4, P0=101325;
const TEMPS=[-15,-10,-5,0,5,10,15,20,25,30,35];

function interp1(x, table){
  if(x<=table[0][0]) return table[0][1];
  const n=table.length;
  if(x>=table[n-1][0]) return table[n-1][1];
  for(let k=0;k<n-1;k++){
    if(x>=table[k][0] && x<=table[k+1][0]){
      const t=(x-table[k][0])/(table[k+1][0]-table[k][0]);
      return table[k][1]+t*(table[k+1][1]-table[k][1]);
    }
  }
  return table[n-1][1];
}
function interpShift(T, shiftTable){
  if(T<=TEMPS[0]) return shiftTable[0];
  if(T>=TEMPS[10]) return shiftTable[10];
  for(let k=0;k<10;k++){
    if(T>=TEMPS[k] && T<=TEMPS[k+1]){
      const t=(T-TEMPS[k])/5;
      return shiftTable[k]+t*(shiftTable[k+1]-shiftTable[k]);
    }
  }
  return shiftTable[10];
}
// Generic piecewise-linear interpolation over arbitrary [x,y] pairs (e.g. a real
// per-round [temperature, muzzle velocity] table read off a range card).
function interpTable(x, pairs){
  const n=pairs.length;
  if(x<=pairs[0][0]) return pairs[0][1];
  if(x>=pairs[n-1][0]) return pairs[n-1][1];
  for(let k=0;k<n-1;k++){
    if(x>=pairs[k][0] && x<=pairs[k+1][0]){
      const t=(x-pairs[k][0])/(pairs[k+1][0]-pairs[k][0]);
      return pairs[k][1]+t*(pairs[k+1][1]-pairs[k][1]);
    }
  }
  return pairs[n-1][1];
}
function airProps(Tc){
  const Tk=Tc+273.15;
  return { rho: P0/(Rspec*Tk), a: Math.sqrt(GAMMA*Rspec*Tk) };
}
// The 9-point temperature grid used on the real range cards (-15..35, uneven at the ends).
const CARD_TEMPS=[-15,-5,5,10,15,20,25,30,35];
// Look up a real (hardcoded, exact) hold value for a given range card row at the
// requested temperature. `row` is 9 values aligned to CARD_TEMPS; use null for a
// "###" cell (round unusable/no data at that temperature on the real card).
// Interpolates between the nearest valid points; clamps flat beyond the valid edges.
function interpRealRow(Tc, row){
  const pts=[];
  for(let i=0;i<CARD_TEMPS.length;i++){ if(row[i]!==null) pts.push([CARD_TEMPS[i],row[i]]); }
  if(pts.length===0) return null;
  if(Tc<=pts[0][0]) return pts[0][1];
  if(Tc>=pts[pts.length-1][0]) return pts[pts.length-1][1];
  for(let k=0;k<pts.length-1;k++){
    if(Tc>=pts[k][0] && Tc<=pts[k+1][0]){
      const t=(Tc-pts[k][0])/(pts[k+1][0]-pts[k][0]);
      return pts[k][1]+t*(pts[k+1][1]-pts[k][1]);
    }
  }
  return pts[pts.length-1][1];
}
function buildParams(ammoKey, Tc){
  const ammo=AMMO[ammoKey];
  const {rho,a}=airProps(Tc);
  let v0;
  if(ammo.mvTable){
    // Real measured muzzle velocity per temperature from a range card — interpolate directly.
    v0=interpTable(Tc,ammo.mvTable);
  } else {
    const mvShift = interpShift(Tc,ammo.shift) - interpShift(21,ammo.shift);
    v0 = ammo.mv21 + mvShift;
  }
  const d_in = ammo.caliber/25.4;
  const w_lb = ammo.mass/453.59237;
  const sd = w_lb/(d_in*d_in);
  const iFactor = sd/ammo.bc;
  const table = ammo.drag===7 ? G7 : G1;
  const area = Math.PI*Math.pow(ammo.caliber/1000/2,2);
  const mass_kg = ammo.mass/1000;
  return {v0, rho, a, iFactor, table, area, mass_kg};
}
function derivs(vx,vy,p){
  const v=Math.sqrt(vx*vx+vy*vy);
  const mach=v/p.a;
  const cd=p.iFactor*interp1(mach,p.table);
  const adrag=0.5*p.rho*v*v*cd*p.area/p.mass_kg;
  return { ax:-adrag*vx/v, ay:-Gc-adrag*vy/v };
}
// Single integration pass; returns {y,v,t} at each requested range checkpoint (meters).
// y0 = starting height relative to the (horizontal) sight line — negative because the
// bore sits below the sight by heightOverBore.
function simulate(p, thetaRad, checkpoints, dt, y0){
  y0 = y0 || 0;
  let x=0,y=y0,vx=p.v0*Math.cos(thetaRad),vy=p.v0*Math.sin(thetaRad),t=0;
  const targets=[...checkpoints].sort((a,b)=>a-b);
  const results={};
  let ti=0;
  const maxX=targets[targets.length-1];
  let px=x,py=y,pt=t,pvx=vx,pvy=vy;
  while(x<maxX && t<12){
    const d1=derivs(vx,vy,p);
    const vxm=vx+d1.ax*dt/2, vym=vy+d1.ay*dt/2;
    const xm=x+vx*dt/2, ym=y+vy*dt/2;
    const d2=derivs(vxm,vym,p);
    const nvx=vx+d2.ax*dt, nvy=vy+d2.ay*dt;
    const nx=x+vxm*dt, ny=y+vym*dt;
    px=x;py=y;pt=t;pvx=vx;pvy=vy;
    x=nx;y=ny;vx=nvx;vy=nvy;t+=dt;
    while(ti<targets.length && x>=targets[ti]){
      const frac=(targets[ti]-px)/(x-px);
      const yy=py+frac*(y-py);
      const vvx=pvx+frac*(vx-pvx), vvy=pvy+frac*(vy-pvy);
      const tt=pt+frac*dt;
      results[targets[ti]]={y:yy, v:Math.sqrt(vvx*vvx+vvy*vvy), t:tt};
      ti++;
    }
  }
  return results;
}
function solveZeroAngle(p, zeroRange, dt, y0){
  let lo=0, hi=0.35;
  const fAt=(th)=> simulate(p,th,[zeroRange],dt,y0)[zeroRange].y;
  let fLo=fAt(lo), fHi=fAt(hi);
  let guard=0;
  while(fHi<0 && guard<8){ hi+=0.2; fHi=fAt(hi); guard++; }
  for(let i=0;i<28;i++){
    const mid=(lo+hi)/2;
    const fMid=fAt(mid);
    if(fMid>0){ hi=mid; } else { lo=mid; }
  }
  return (lo+hi)/2;
}

// ---------- UI ----------
const calSel=document.getElementById('caliber');
Object.entries(AMMO).forEach(([key,a])=>{
  const opt=document.createElement('option');
  opt.value=key; opt.textContent=a.label;
  calSel.appendChild(opt);
});
calSel.value="65creed";

const targetInp=document.getElementById('targetRange');
const tempSlider=document.getElementById('temp');
const tempVal=document.getElementById('tempVal');
const hobInp=document.getElementById('heightOverBore');

calSel.addEventListener('change', ()=>{
  const a=AMMO[calSel.value];
  if(a.hob) hobInp.value=a.hob;
});
const ZERO_RANGE=100; // always zeroed at 100 m

function fmt(n,d=1){ return n.toFixed(d); }

function render(){
  const ammoKey=calSel.value;
  const ammo=AMMO[ammoKey];
  const zero=ZERO_RANGE;
  const target=Math.max(25,Math.min(2500,parseFloat(targetInp.value)||500));
  const Tc=parseFloat(tempSlider.value);
  tempVal.textContent=Tc+"°C";

  const dt=0.0006;
  const p=buildParams(ammoKey,Tc);
  const hob_in = Math.max(0,Math.min(6,parseFloat(hobInp.value)||0));
  const hob_m = (hob_in*25.4)/1000;
  const y0=-hob_m;
  const theta=solveZeroAngle(p,zero,dt,y0);

  // range card checkpoints
  const maxR=ammo.maxRange;
  const checkpoints=[];
  for(let r=100;r<=maxR;r+=100) checkpoints.push(r);
  if(!checkpoints.includes(target)) checkpoints.push(target);
  if(!checkpoints.includes(zero)) checkpoints.push(zero);

  const results=simulate(p,theta,checkpoints,dt,y0);

  // Hero
  const tRes=results[target];
  const holdMils=-tRes.y/target*1000;
  const dirLabel = holdMils>=0 ? "Hold Over" : "Hold Under";
  document.getElementById('holdDir').textContent=dirLabel;
  document.getElementById('holdValue').textContent=fmt(Math.abs(holdMils),1);
  document.getElementById('holdSub').textContent=
    `${ammo.label} · at ${target} m, zeroed 100 m, ${Tc}°C`;

  const hero=document.getElementById('hero');
  hero.classList.remove('pulse'); void hero.offsetWidth; hero.classList.add('pulse');

  // Stats
  document.getElementById('statVel').textContent=fmt(tRes.v,0)+" m/s";
  document.getElementById('statTof').textContent=fmt(tRes.t,2)+" s";
  const mach=tRes.v/p.a;
  const statMach=document.getElementById('statMach');
  if(mach>1.05){ statMach.textContent="Supersonic"; statMach.className="v ok"; }
  else if(mach>0.95){ statMach.textContent="Transonic"; statMach.className="v warn"; }
  else { statMach.textContent="Subsonic"; statMach.className="v warn"; }

  // Table
  const body=document.getElementById('rangeTableBody');
  body.innerHTML="";
  for(let r=100;r<=maxR;r+=100){
    const res=results[r];
    const mils=-res.y/r*1000;
    const m=res.v/p.a;
    const tr=document.createElement('tr');
    if(r===Math.round(target/100)*100 && Math.abs(r-target)<50) tr.classList.add('current');
    if(m<1.05) tr.classList.add('transonic');
    tr.innerHTML=`<td>${r} m</td><td>${mils>=0?'+':''}${fmt(mils,1)}</td><td>${fmt(res.v,0)}</td><td>${fmt(res.t,2)}s</td>`;
    body.appendChild(tr);
  }
}

[calSel,targetInp,tempSlider,hobInp].forEach(el=>{
  el.addEventListener('input',render);
  el.addEventListener('change',render);
});

render();
</script>
</body>
</html>
